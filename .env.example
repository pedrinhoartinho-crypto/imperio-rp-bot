DISCORD_TOKEN=cole_o_token_do_bot_aqui
GUILD_ID=cole_o_id_do_servidor_aqui

# Logs do jogo (Roblox -> bot -> canais da categoria 「📊」LOGS)
# Gere um token longo e use o MESMO valor no LogsConfig do Roblox.
LOG_TOKEN=troque_por_um_token_longo_e_aleatorio
LOG_GUILD_ID=

# ---- Loja / entrega de produtos (sem Open Cloud) ----
# Segredo que vai no caminho da URL (use o MESMO valor no LojaConfig do Roblox).
LOJA_KEY_SECRET=troque_por_um_segredo_longo_e_aleatorio

# Upstash Redis (recomendado; obrigatório no Render, cujo disco é efêmero).
# Crie em https://console.upstash.com/redis e copie a URL REST e o token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Modo local (fallback para testes sem Upstash): pasta servida por HTTP/túnel.
# LOJA_KEY_DIR=/caminho/da/pasta-publica/loja
LOJA_DATA_DIR=

KEY_PREFIX=ASSAULT

# Pix mostrado no ticket
PIX_KEY=
PIX_NAME=

# OCR dos comprovantes (OCR.space). Sem isso, a loja só entrega com aprovação manual.
# Crie uma chave gratuita em https://ocr.space/ocrapi
OCR_API_KEY=
OCR_LANGUAGE=por
OCR_ENGINE=2
RECEIPT_MAX_AGE_DAYS=7
LOJA_MAX_RECEIPT_MB=8

# Canal de log das vendas (opcional; padrão: ticket-logs)
LOJA_LOG_CHANNEL=
